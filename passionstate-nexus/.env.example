[TEMPLATE]
# HTTP listen port
PORT=8080
NODE_ENV=development
DEFAULT_JURISDICTION=GLOBAL

# Archive ledger storage mode.
#   mock     - in-process memory; ALL state is lost on restart (dev only)
#   firestore- durable append-only event store via Firestore adapter
ARCHIVE_LEDGER_MODE=mock

# Bearer token guarding /mcp. Leave EMPTY only for local dev / stdio.
# Generate one for networked deployments:
#   openssl rand -hex 32
NEXUS_MCP_TOKEN=
